package "boot" (
  directory = "boot"
  version = "dev"
  description = "Rocq Enviroment and Paths facilities"
  requires = "rocq-runtime.clib rocq-runtime.config"
)
package "checklib" (
  directory = "checklib"
  version = "dev"
  description = "Rocq's Standalone Proof Checker"
  requires = "rocq-runtime.boot rocq-runtime.kernel"
)
package "clib" (
  directory = "clib"
  version = "dev"
  description = "Coq's Utility Library [general purpose]"
  requires = "memprof-limits str threads unix"
)
package "config" (
  directory = "config"
  version = "dev"
  description = "Rocq Configuration Variables"
  requires = ""
  package "byte" (
    directory = "byte"
    version = "dev"
    description = "Rocq Configuration Variables (for bytecode only)"
    requires = "compiler-libs.toplevel"
  )
)
package "coqargs" (
  directory = "coqargs"
  version = "dev"
  description = "Rocq command line argument parsing"
  requires = "rocq-runtime.boot rocq-runtime.clib rocq-runtime.config"
)
package "coqdeplib" (
  directory = "coqdeplib"
  version = "dev"
  description = ""
  requires = "findlib.internal rocq-runtime.boot rocq-runtime.lib"
)
package "coqworkmgrapi" (
  directory = "coqworkmgrapi"
  version = "dev"
  description = ""
  requires = "str unix"
)
package "debugger_support" (
  directory = "debugger_support"
  version = "dev"
  description = "Rocq Support for ocamldebug"
  requires = "rocq-runtime.dev"
)
package "dev" (
  directory = "dev"
  version = "dev"
  description = "Rocq's Debug Printers"
