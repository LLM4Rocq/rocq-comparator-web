  "rocq-runtime.plugins.ltac rocq-runtime.plugins.ltac2 rocq-runtime.vernac"
)
package "engine" (
  directory = "engine"
  version = "dev"
  description = "Rocq's Tactic Engine"
  requires = "rocq-runtime.library"
)
package "gramlib" (
  directory = "gramlib"
  version = "dev"
  description = ""
  requires = "rocq-runtime.lib"
)
package "interp" (
  directory = "interp"
  version = "dev"
  description =
  "Rocq's Syntactic Interpretation for AST [notations, implicits]"
  requires = "rocq-runtime.gramlib rocq-runtime.pretyping zarith"
)
package "kernel" (
  directory = "kernel"
  version = "dev"
  description = "The Rocq Kernel"
  requires = "dynlink rocq-runtime.boot rocq-runtime.lib rocq-runtime.vm"
)
package "lib" (
  directory = "lib"
  version = "dev"
  description = "Rocq's Utility Library [rocq-specific]"
  requires = "rocq-runtime.boot rocq-runtime.clib rocq-runtime.config"
)
package "library" (
  directory = "library"
  version = "dev"
  description = "Rocq's Loadable Libraries (vo) Support"
  requires = "rocq-runtime.kernel"
)
package "parsing" (
  directory = "parsing"
  version = "dev"
  description = ""
  requires = "rocq-runtime.gramlib rocq-runtime.interp"
)
package "plugins" (
  directory = "plugins"
