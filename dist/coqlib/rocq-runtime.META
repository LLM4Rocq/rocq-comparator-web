package "rocqshim" (
  directory = "rocqshim"
  version = "dev"
  description = "Rocq support for finding and exec-ing subcommands"
  requires = "findlib rocq-runtime.boot unix"
)
package "stm" (
  directory = "stm"
  version = "dev"
  description = "Rocq's Document Manager and Proof Checking Scheduler"
  requires = "rocq-runtime.coqworkmgrapi rocq-runtime.sysinit"
)
package "sysinit" (
  directory = "sysinit"
  version = "dev"
  description = "Rocq's initialization"
